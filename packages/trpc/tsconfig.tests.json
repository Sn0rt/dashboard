{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": ".test-dist",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": [
    "server/resources/**/*.ts",
    "server/router/pagination.ts",
    "server/utils/**/*.ts",
    "tests/**/*.ts"
  ]
}
